# Documentation: https://docs.livekit.io/home/self-hosting/deployment/#configuration
{% set internet_mode = livekit_network_mode in ['both', 'internet'] %}
keys:
    meet: {{ livekit_secret_key }}
logging:
    level: info
port: {{ port_livekit }}
bind_addresses:
  - 127.0.0.1
  - ::1
redis:
    address: localhost:6379
    db: {{ redis_db }}
rtc:
    port_range_start: 49152
    port_range_end: 65535
    tcp_port: {{ port_tcp }}
    turn_servers: null
    use_external_ip: {{ 'true' if internet_mode else 'false' }}
    advertise_internal_ip: {{ 'true' if livekit_network_mode == 'both' else 'false' }}
    # FIXME: probably better switch to coturn?
    {% if internet_mode %}
    stun_servers:
      - stun.nextcloud.com:443
    {% endif %}

turn:
    enabled: {{ 'true' if internet_mode else 'false' }}
    domain: {{ turn_domain }}
    tls_port: {{ port_turn }}
    udp_port: {{ port_turn_udp }}
    external_tls: true
